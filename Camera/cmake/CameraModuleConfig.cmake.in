@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
foreach(_component IN ITEMS Common GenTL GenTLGenApi Amscope AmscopeQt Qt QtWidgets)
    set(CameraModule_${_component}_FOUND FALSE)
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/CameraCommonTargets.cmake")
set(CameraModule_Common_FOUND TRUE)

if("GenTL" IN_LIST CameraModule_FIND_COMPONENTS OR "GenTLGenApi" IN_LIST CameraModule_FIND_COMPONENTS)
    if(@CAMERA_MODULE_HAS_GENTL@)
        include("${CMAKE_CURRENT_LIST_DIR}/CameraGenTLTargets.cmake")
        set(CameraModule_GenTL_FOUND TRUE)
    endif()
endif()
if("GenTLGenApi" IN_LIST CameraModule_FIND_COMPONENTS)
    if(@CAMERA_MODULE_HAS_GENAPI@)
        find_dependency(GenApi 3.5.1 EXACT CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/CameraGenTLGenApiTargets.cmake")
        set(CameraModule_GenTLGenApi_FOUND TRUE)
    endif()
endif()

if("Amscope" IN_LIST CameraModule_FIND_COMPONENTS OR
   ("AmscopeQt" IN_LIST CameraModule_FIND_COMPONENTS AND @CAMERA_MODULE_HAS_AMSCOPE_QT@))
    if(@CAMERA_MODULE_HAS_AMSCOPE@)
        include("${CMAKE_CURRENT_LIST_DIR}/AmscopeDriverTargets.cmake")
        set(CameraModule_Amscope_FOUND TRUE)
    endif()
endif()
if("Qt" IN_LIST CameraModule_FIND_COMPONENTS OR
   ("AmscopeQt" IN_LIST CameraModule_FIND_COMPONENTS AND @CAMERA_MODULE_HAS_AMSCOPE_QT@))
    if(@CAMERA_MODULE_HAS_QT@)
        find_dependency(Qt6 6.2 COMPONENTS Core)
        include("${CMAKE_CURRENT_LIST_DIR}/CameraQtTargets.cmake")
        set(CameraModule_Qt_FOUND TRUE)
    endif()
endif()
if("QtWidgets" IN_LIST CameraModule_FIND_COMPONENTS)
    if(@CAMERA_MODULE_HAS_QT_WIDGETS@)
        find_dependency(Qt6 6.2 COMPONENTS Widgets)
        include("${CMAKE_CURRENT_LIST_DIR}/CameraQtWidgetsTargets.cmake")
        set(CameraModule_QtWidgets_FOUND TRUE)
    endif()
endif()
if("AmscopeQt" IN_LIST CameraModule_FIND_COMPONENTS)
    if(@CAMERA_MODULE_HAS_AMSCOPE_QT@ AND CameraModule_Amscope_FOUND AND CameraModule_Qt_FOUND)
        find_dependency(Qt6 6.2 COMPONENTS Core)
        include("${CMAKE_CURRENT_LIST_DIR}/AmscopeQtTargets.cmake")
        set(CameraModule_AmscopeQt_FOUND TRUE)
    endif()
endif()
check_required_components(CameraModule)
